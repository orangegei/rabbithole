.bottom-tab-bar {
  position: fixed;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  left: 24rpx;
  z-index: 10;
  display: flex;
  align-items: center;
  height: 118rpx;
  box-sizing: border-box;
  padding: 8rpx;
  background: rgba(255, 249, 237, 0.96);
  border: 2rpx solid rgba(131, 88, 44, 0.2);
  border-radius: 60rpx;
  box-shadow: 0 8rpx 20rpx rgba(94, 63, 30, 0.18);
}

.bottom-tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #8a6948;
  border-radius: 52rpx;
}

.bottom-tab-item--pressed {
  transform: scale(0.96);
  opacity: 0.82;
}

.bottom-tab-icon {
  width: 62rpx;
  height: 62rpx;
}

.bottom-tab-label {
  margin-top: -2rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.2;
}

.bottom-tab-item--selected {
  color: #5b351a;
}

.bottom-tab-item--selected .bottom-tab-label {
  font-weight: 600;
}
