<view wx:if="{{shouldRender}}" class="city-picker {{isClosing ? 'city-picker--closing' : ''}}">
  <view
    class="city-picker__mask"
    bindtap="close"
    aria-role="button"
    aria-label="关闭城市选择"
  ></view>

  <view class="city-picker__sheet" catchtap="preventTapThrough" aria-role="dialog" aria-label="选择城市">
    <view class="city-picker__handle"></view>
    <view class="city-picker__header">
      <view>
        <text class="city-picker__title">选择城市</text>
        <text class="city-picker__subtitle">开启一段新的探案旅程</text>
      </view>
      <view
        class="city-picker__close"
        bindtap="close"
        hover-class="city-picker__close--pressed"
        hover-stay-time="80"
        aria-role="button"
        aria-label="关闭"
      >
        <text class="city-picker__close-icon" aria-hidden="true">×</text>
      </view>
    </view>

    <view class="city-picker__choices">
      <view
        class="city-choice city-choice--current"
        bindtap="close"
        hover-class="city-choice--pressed"
        hover-stay-time="80"
        aria-role="button"
        aria-label="南京，当前城市"
      >
        <view class="city-choice__pin">
          <view class="city-choice__pin-dot"></view>
        </view>
        <text class="city-choice__title">南京</text>
        <text class="city-choice__status">当前城市</text>
      </view>

      <view class="city-choice city-choice--developing" aria-label="其他城市正在开发中">
        <view class="city-choice__developing-mark">···</view>
        <text class="city-choice__title">其他城市</text>
        <text class="city-choice__status">正在开发中，敬请期待</text>
      </view>
    </view>
  </view>
</view>
