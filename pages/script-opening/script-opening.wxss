page {
  width: 100%;
  min-height: 100%;
  background: #fffaf0;
}

.script-opening-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 120rpx 48rpx;
}

.script-opening-content {
  padding: 56rpx 40rpx;
  background: #fffdf7;
  border: 2rpx solid rgba(126, 85, 43, 0.24);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(94, 63, 30, 0.12);
}

.script-opening-title {
  display: block;
  color: #4e371e;
  font-size: 48rpx;
  font-weight: 600;
  text-align: center;
}
